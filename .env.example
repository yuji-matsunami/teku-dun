# Copy this file to .env for local development.
POSTGRES_DB=teku_dun
POSTGRES_USER=teku_dun
POSTGRES_PASSWORD=teku_dun
DB_PORT=5432
# This URL is for the migrate container (host name: db), not the future Go host-side DATABASE_URL.
# If POSTGRES_* values change, update this URL too; URL credentials must be percent-encoded.
MIGRATE_DATABASE_URL=postgres://teku_dun:teku_dun@db:5432/teku_dun?sslmode=disable
